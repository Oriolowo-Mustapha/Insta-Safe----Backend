# InstaSafe local secrets template — tracked. Copy to .env (gitignored) and fill in.
# Double underscore (__) maps to ':' config hierarchy (e.g. OpenWA__ApiKey -> OpenWA:ApiKey).

# Database (used by the app AND 'dotnet ef database update' via AppDbContextFactory)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=instasafe;Username=postgres;Password=YOUR_POSTGRES_PASSWORD

# Set ApplyMigrations=true ONLY on hosted environments (Azure) so EF
# migrations run once on boot. Keep unset/false locally.
# ApplyMigrations=false

# Paystack (payment collection + transfers)
Paystack__SecretKey=YOUR_PAYSTACK_SECRET_KEY
Paystack__BaseUrl=https://api.paystack.co

# Groq (order-text NLP parsing)
Groq__ApiKey=YOUR_GROQ_API_KEY
Groq__Model=openai/gpt-oss-120b

# OpenWA self-hosted WhatsApp gateway
OpenWA__BaseUrl=http://localhost:2785
OpenWA__ApiKey=YOUR_OPENWA_API_KEY
OpenWA__SessionId=YOUR_OPENWA_SESSION_ID
OpenWA__WebhookSecret=YOUR_OPENWA_WEBHOOK_SECRET

# Auth (vendor phone-OTP -> JWT). JwtKey must be 32+ chars.
Auth__JwtKey=YOUR_32_PLUS_CHAR_JWT_SIGNING_KEY_HERE
Auth__TokenHours=24
Auth__OtpMinutes=10

# Email via Brevo SMTP (https://app.brevo.com -> SMTP & API -> SMTP keys)
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__Username=YOUR_BREVO_SMTP_LOGIN
Smtp__Password=YOUR_BREVO_SMTP_KEY
Smtp__FromEmail=no-reply@instasafe.ng
Smtp__FromName=InstaSafe

# Web dashboard links used in WhatsApp gate replies (signup/onboarding nudges)
Frontend__BaseUrl=https://app.instasafe.ng

# Azure live logging (Application Insights). Create once, paste the
# connection string here for local testing or into Azure App Settings.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
